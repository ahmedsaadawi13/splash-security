# SplashSecurity Environment Configuration

# Database Configuration
DB_HOST=localhost
DB_NAME=splash_security
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application Configuration
APP_NAME="SplashSecurity"
APP_URL=http://localhost
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC

# Session Configuration
SESSION_LIFETIME=7200
SESSION_NAME=splash_security_session

# Security
CSRF_TOKEN_NAME=csrf_token
PASSWORD_HASH_ALGO=PASSWORD_BCRYPT

# Email Configuration (for future real SMTP)
MAIL_FROM_ADDRESS=noreply@splashsecurity.com
MAIL_FROM_NAME="SplashSecurity"

# API Configuration
API_RATE_LIMIT_DEFAULT=100
API_RATE_LIMIT_WINDOW=3600

# Scanning Configuration
SCAN_TIMEOUT=30
MAX_CONCURRENT_SCANS=5

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,txt,jpg,png,cert,pem

# Logging
LOG_LEVEL=debug
LOG_FILE=storage/logs/app.log
